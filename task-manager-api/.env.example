# Copie para .env e ajuste. Nada de segredo versionado.
SECRET_KEY=change-me-in-production
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
DATABASE_URI=sqlite:///tasks.db
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# SMTP (NotificationService)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Paginação
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100

# Token
TOKEN_MAX_AGE=86400
