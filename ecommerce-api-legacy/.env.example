# Server
PORT=3000

# CORS allowlist (comma-separated origins). Empty = same-origin only.
CORS_ORIGINS=http://localhost:3000

# Body size limit for JSON payloads
JSON_BODY_LIMIT=100kb

# Bcrypt work factor
BCRYPT_ROUNDS=10

# Payment gateway (NEVER commit real values)
PAYMENT_GATEWAY_KEY=pk_test_replace_me

# Database file path (":memory:" for in-memory)
DB_PATH=:memory:
